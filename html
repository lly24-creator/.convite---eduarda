<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Um convite para Eduarda 💗</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <div class="card">
    <div class="heart">💗</div>

    <h1>Eduarda, tenho um convite! 🥰</h1>

    <p class="subtitle">
      Que tal a gente sair juntos? 👀💕<br>
      Você escolhe quando e onde!
    </p>

    <section>
      <h2>📅 Escolha o dia</h2>
      <div class="options">
        <button data-tipo="dia">Dia 19</button>
        <button data-tipo="dia">Dia 20</button>
        <button data-tipo="dia">Dia 26</button>
      </div>
    </section>

    <section>
      <h2>⏰ Escolha o horário</h2>
      <div class="options">
        <button data-tipo="hora">11:00 - 14:00 ☀️</button>
        <button data-tipo="hora">20:00 - 23:00 🌙</button>
      </div>
    </section>

    <section>
      <h2>📍 Onde vamos?</h2>
      <div class="options">
        <button data-tipo="local">🎬 Cinema</button>
        <button data-tipo="local">🥪 Subway</button>
        <button data-tipo="local">🛍️ Shopping</button>
      </div>
    </section>

    <button id="confirmar">
      💕 Aceitar o convite!
    </button>

    <div id="resultado"></div>

    <p class="small">
      P.S.: escolher "sim" é altamente recomendado 😌💗
    </p>
  </div>

  <script src="script.js"></script>
</body>
</html>
